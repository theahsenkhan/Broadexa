# ── Database (Supabase Postgres — use the "Transaction pooler" connection string) ──
DATABASE_URI=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# ── Payload (generate a long random string, keep it secret) ──
PAYLOAD_SECRET=change-me-to-a-long-random-string

# ── App URL ──
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Phase 2: Cloudflare R2 (asset file storage) ──
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=broadexa-assets

# ── Phase 3: Stripe Connect ──
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Sign in with Google (Google Cloud Console → APIs & Services → Credentials → OAuth client ID) ──
# Authorized redirect URI to register: {NEXT_PUBLIC_SERVER_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Sign in with LinkedIn (LinkedIn Developer Portal → "Sign In with LinkedIn using OpenID Connect" product) ──
# Authorized redirect URI to register: {NEXT_PUBLIC_SERVER_URL}/api/auth/linkedin/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
